// Nodo de la cola
struct Node {
    float x, y;
    float radius;
    ofColor color;
    float opacity;

    Node* next;

    Node(float _x, float _y, float _radius,
         ofColor _color, float _opacity)
        : x(_x),
          y(_y),
          radius(_radius),
          color(_color),
          opacity(_opacity),
          next(nullptr) {
    }
};


// Implementación manual de una cola FIFO
class BrushQueue {
public:
    Node* front;
    Node* rear;

    int size;
    int maxSize;

    BrushQueue(int _maxSize);
    ~BrushQueue();

    void enqueue(float x, float y,
                 float radius,
                 ofColor color,
                 float opacity);

    void dequeue();
    void clear();
    bool isEmpty();
};


// Constructor
inline BrushQueue::BrushQueue(int _maxSize)
    : front(nullptr),
      rear(nullptr),
      size(0),
      maxSize(_maxSize) {
}


// Destructor
inline BrushQueue::~BrushQueue() {
    clear();
}


// Agregar un nodo al FINAL de la cola
inline void BrushQueue::enqueue(
    float x,
    float y,
    float radius,
    ofColor color,
    float opacity) {

    // 1. Crear nuevo nodo en el heap
    Node* nuevo = new Node(
        x,
        y,
        radius,
        color,
        opacity
    );

    // 2. Si la cola está vacía
    if (isEmpty()) {
        front = nuevo;
        rear = nuevo;
    }
    else {
        // El último nodo apunta al nuevo
        rear->next = nuevo;

        // Ahora el nuevo es el último
        rear = nuevo;
    }

    size++;

    // 3. Si supera el máximo,
    // eliminar el más antiguo
    if (size > maxSize) {
        dequeue();
    }
}


// Eliminar el nodo más antiguo
inline void BrushQueue::dequeue() {

    // Si está vacía no hacemos nada
    if (isEmpty()) {
        return;
    }

    // Guardar temporalmente el nodo a eliminar
    Node* temp = front;

    // front avanza al siguiente nodo
    front = front->next;

    // Liberar la memoria
    delete temp;

    size--;

    // Si después de borrar quedó vacía
    if (front == nullptr) {
        rear = nullptr;
    }
}


// Eliminar todos los nodos
inline void BrushQueue::clear() {

    // Mientras haya nodos
    while (!isEmpty()) {
        dequeue();
    }

    front = nullptr;
    rear = nullptr;
    size = 0;
}


// Saber si la cola está vacía
inline bool BrushQueue::isEmpty() {
    return front == nullptr;
}


