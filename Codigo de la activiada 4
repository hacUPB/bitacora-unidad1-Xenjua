#include "ofApp.h"

//--------------------------------------------------------------
void ofApp::setup() {

    ofBackground(0);

}


//--------------------------------------------------------------
void ofApp::update() {

    // Cambiar progresivamente el color del fondo
    backgroundHue += 0.2;

    if (backgroundHue > 255) {
        backgroundHue = 0;
    }


    // Guardamos la posición anterior del mouse
    static int anteriorX = mouseX;
    static int anteriorY = mouseY;


    // Si el mouse se movió
    if (mouseX != anteriorX || mouseY != anteriorY) {

        // Radio aleatorio
        float radius = ofRandom(5, 25);

        // Color aleatorio
        ofColor color(
            ofRandom(0, 255),
            ofRandom(0, 255),
            ofRandom(0, 255)
        );

        // Opacidad aleatoria
        float opacity = ofRandom(100, 255);


        // Agregar el nuevo trazo a la cola
        strokes.enqueue(
            mouseX,
            mouseY,
            radius,
            color,
            opacity
        );


        // Actualizar posición anterior
        anteriorX = mouseX;
        anteriorY = mouseY;
    }
}


//--------------------------------------------------------------
void ofApp::draw() {

    // Fondo con gradiente dinámico
    ofColor color1;
    ofColor color2;

    color1.setHsb(
        backgroundHue,
        150,
        240
    );

    color2.setHsb(
        fmod(backgroundHue + 128, 255),
        150,
        240
    );

    ofBackgroundGradient(
        color1,
        color2,
        OF_GRADIENT_LINEAR
    );


    // Comenzamos desde el primer nodo
    Node* actual = strokes.front;


    // Recorremos toda la cola
    while (actual != nullptr) {

        // Establecer color y opacidad
        ofSetColor(
            actual->color,
            actual->opacity
        );

        // Dibujar el trazo
        ofDrawCircle(
            actual->x,
            actual->y,
            actual->radius
        );

        // Pasar al siguiente nodo
        actual = actual->next;
    }


    // Restaurar color
    ofSetColor(255);
}


//--------------------------------------------------------------
void ofApp::keyPressed(int key) {

    // Limpiar todos los trazos
    if (key == 'c') {

        strokes.clear();

        cout << "Cola limpiada" << endl;
    }


    // Alternar entre 50 y 100
    if (key == 'a') {

        if (strokes.maxSize == 50) {

            strokes.maxSize = 100;

            cout << "Tamanio maximo: 100" << endl;
        }
        else {

            strokes.maxSize = 50;

            cout << "Tamanio maximo: 50" << endl;


            // Si actualmente hay más de 50,
            // eliminamos los más antiguos
            while (strokes.size > strokes.maxSize) {
                strokes.dequeue();
            }
        }
    }


    // Guardar captura
    else if (key == 's') {

        ofSaveScreen("captura.png");

        cout << "Captura guardada" << endl;
    }
}
